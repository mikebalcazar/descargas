+def descarga(app):
+    """La liga de descarga y la version, leidas de `<app>.json`.
+
+    POR QUE SE LEE DE AHI Y NO SE ESCRIBE A MANO, que es como estaba:
+
+      · LA LIGA. El boton apuntaba a la PAGINA del tag en GitHub, no al
+        archivo, asi que al picarlo se abria el portal y habia que buscar el
+        instalador entre los renglones. Mike, 1-oct-2026: «que cuando le den
+        click al link de la pagina web de suite101, se comience a descargar la
+        ultima version». La liga del archivo lleva la version en el nombre, asi
+        que escrita a mano envejece cada entrega; leida de aqui, no.
+
+      · LA VERSION. La ficha decia «0.20.3 · 12-sep-2026» cuando ya iba la
+        0.22.2 del 1-oct. Tres semanas de atraso en la cara del cliente, y
+        nadie lo noto porque nada lo comparaba contra nada.
+
+    `<app>.json` es lo que el corredor que publica el instalador deja en main
+    en cada entrega: es la unica fuente que no puede quedarse atras.
+
+    REVIENTA SI NO ESTA, a proposito. Una liga de descarga que calla y apunta a
+    cualquier cosa es peor que un sitio que no se arma.
+    """
+    import json
+    d = json.loads((RAIZ / f'{app}.json').read_text(encoding='utf-8'))[app]
+    w = d['windows']
+    a, m, dia = d['fecha'].split('-')
+    mb = round(w['bytes'] / 1024 / 1024)
+    return w['url'], f"{d['version']} · {int(dia)}-{MESES[int(m) - 1]}-{a}", f"{mb} MB"
+
